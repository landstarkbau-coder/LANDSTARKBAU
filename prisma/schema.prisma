generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"   // або інший шлях у вашому проєкті
}
datasource db {
  provider = "postgresql"
}

// ─── АВТОРИЗАЦІЯ (Auth.js) ────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Для логіну по email/паролю
  role          String    @default("ADMIN") // Поки що всі юзери - адміни
  accounts      Account[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ─── ПРОЄКТИ ──────────────────────────────────────
model Project {
  id          String   @id @default(cuid())
  number      Int      @unique

  // ─── Німецькі поля ───────────────────────────────
  nameDe        String
  subtitleDe    String?
  locationDe    String
  descriptionDe String

  // ─── Англійські поля ─────────────────────────────
  nameEn        String
  subtitleEn    String?
  locationEn    String
  descriptionEn String

  // ─── Українські поля ─────────────────────────────
  nameUa        String
  subtitleUa    String?
  locationUa    String
  descriptionUa String

  // ─── Російські поля ──────────────────────────────
  nameRu        String
  subtitleRu    String?
  locationRu    String
  descriptionRu String

  // ─── Категорії (чотири мови) ─────────────────────
  categoryDe    String
  categoryEn    String
  categoryUa    String
  categoryRu    String

  // ─── Послуги (масиви в чотирьох мовах) ───────────
  servicesDe    Json     @default("[]")
  servicesEn    Json     @default("[]")
  servicesUa    Json     @default("[]")
  servicesRu    Json     @default("[]")

  // ─── Матеріали (масиви в чотирьох мовах) ─────────
  materialsDe   Json     @default("[]")
  materialsEn   Json     @default("[]")
  materialsUa   Json     @default("[]")
  materialsRu   Json     @default("[]")

  // ─── Спільні поля ────────────────────────────────
  imageUrl          String
  imagePublicId     String?  // NEW: для видалення з Cloudinary
  thumbnailUrl      String
  thumbnailPublicId String?  // NEW: для видалення з Cloudinary
  region            String?
  area              String?
  year              Int?
  
  // NEW: тепер галерея зберігатиме масив об'єктів: [{ url: string, publicId: string }]
  gallery           Json     @default("[]") 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}